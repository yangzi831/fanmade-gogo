# 复制为 .env.cloud，仅存在你自己的电脑；不要提交 Git，也不要粘贴到聊天。
# Supabase Free 项目 Connect → Session pooler（端口 5432，SSL required）
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# 项目 Settings → API Keys → Secret key（或 legacy service_role）
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET
SUPABASE_BUCKET=fanmade-images
# 仅当本地网络阻断数据库直连时填写，例如 socks5://127.0.0.1:7890
# 线上 Functions 留空；不要把本机代理地址配置到云端
DATABASE_PROXY_URL=
# Netlify 创建后的免费 HTTPS 域名，不能带末尾斜线
APP_ORIGIN=https://YOUR_SITE.netlify.app
NODE_ENV=production
TRUST_PROXY=1
# 首次初始化拥有者账号（必须在公开部署前执行；不是演示凭据）
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NICKNAME=
