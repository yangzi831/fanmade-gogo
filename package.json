{
  "name": "wuwei-materials",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --experimental-sqlite --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --experimental-sqlite server/index.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "seed": "node --env-file-if-exists=.env --experimental-sqlite server/seed.mjs",
    "feature:can": "node --env-file-if-exists=.env --experimental-sqlite scripts/feature-can.mjs",
    "cloud:init": "node --env-file=.env.cloud scripts/init-cloud.mjs",
    "cloud:check": "node --env-file=.env.cloud scripts/check-cloud.mjs",
    "cloud:start": "node --env-file=.env.cloud server/cloud/index.mjs",
    "cloud:verify": "node --env-file=.env.cloud scripts/verify-cloud.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.5",
    "socks": "^2.8.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  }
}
